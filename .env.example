# ============================================================
# アイムビ 環境変数テンプレート
# ============================================================
# 実際の値は .env.local に (Git に含めない)。
# 本番は Vercel の Environment Variables に。
# ============================================================

# ---- Supabase (必須) ----
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Supabase CLI (db push) 用。dashboard/account/tokens で発行
SUPABASE_ACCESS_TOKEN=sbp_xxx

# ---- Stripe (必須) ----
# 本番切替時は sk_live_ / pk_live_ に差し替え
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# ---- App URL (必須) ----
# 本番は https://<独自ドメイン> に、双方同じ値で
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Cron 認可 (必須) ----
# Vercel Cron は Bearer <CRON_SECRET> を自動付与。未設定だと全 cron が 401
CRON_SECRET=your_random_secret_here

# ---- Email 通知 (推奨) ----
# Resend Dashboard で発行。ドメイン確定後は独自ドメイン + SPF/DKIM/DMARC 必要
RESEND_API_KEY=re_xxx
# 差出人メールアドレス (例: Aimovie <no-reply@aimovie-works.com>)
NOTIFY_FROM_EMAIL=Aimovie <onboarding@resend.dev>
# 管理者宛通知メール (,) で複数可
ADMIN_NOTIFY_EMAIL=admin@example.com

# ---- Slack 通知 (推奨) ----
# Slack Incoming Webhook URL。管理者 escalation 通知用
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# ---- LINE Login + Push (任意) ----
LINE_CHANNEL_ID=your_line_channel_id
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# ---- Rate Limit (本番推奨) ----
# vercel integration add upstash で自動注入される
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- AI Gateway (任意) ----
# Vercel AI Gateway 経由でモデル呼出し (現状は Anthropic 直呼び)
AI_GATEWAY_API_KEY=
